---
interface Props {
  name: string;
  href: string;
  icon: string;
}
const { name, href, icon } = Astro.props;
---

<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={name}
  class="w-[38px] h-[38px] p-1.5 border border-transparent rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink hover:bg-gray-3"
>
  <img src={icon} width="24" height="24" alt="" />
</a>
