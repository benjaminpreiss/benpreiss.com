---
import PhoneContact from "./PhoneContact.svelte";
interface Props {
  title: string;
  phone: string;
  phoneLabel: string;
  copy: string;
  copied: string;
  copyFailed: string;
}
const { title, ...phone } = Astro.props;
---

<h3 class="type-xl-semibold mt-10">{title}</h3>
<PhoneContact client:load {...phone} />
