---
interface Props {
  unavailable: string;
}
const { unavailable } = Astro.props;
---

<button
  disabled
  type="button"
  class="disabled:opacity-100 disabled:[-webkit-text-fill-color:currentColor] w-full text-white text-center font-fg font-medium text-lg py-1 px-4 mt-4 border-[3px] border-transparent relative bg-ben-gray-4"
>
  <span>{unavailable}</span>
</button>
