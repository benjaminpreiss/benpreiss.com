---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="flex flex-col justify-center items-center mt-6 mb-4 md:mt-0 md:items-start px-4">
  <h2 class="type-lg-semibold md:mt-6 md:type-2xl-semibold">{title}</h2>
  <dl class="grid grid-cols-2 w-full max-w-sm md:max-w-[22rem] type-sm-semibold text-right md:text-left gap-x-7 gap-y-3 mt-3">
    <slot />
  </dl>
</section>
