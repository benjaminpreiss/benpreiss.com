---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section
  {id}
  aria-labelledby={`${id}-title`}
  class="px-8 w-full pt-52 mx-auto max-w-md md:max-w-xl mb-40"
>
  <h3 id={`${id}-title`} class="font-fg font-semibold text-3xl leading-none">
    {title}
  </h3>
  <slot />
</section>
