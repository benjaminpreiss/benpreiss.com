---
import { getEntry, render } from "astro:content";
import "../../styles/globals.css";
const entry = await getEntry("system", "not-found");
if (!entry) throw new Error("Missing not-found document");
const { Content } = await render(entry);
---

<!doctype html>
<html
  lang="de"
  class="font-sans [font-synthesis:none] text-ink [-webkit-tap-highlight-color:transparent]"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={entry.data.description} />
    <title>{entry.data.title}</title>
  </head>
  <body class="type-base-regular [&_strong]:font-bold [&_em]:font-emphasis [&_em]:italic">
    <main class="max-w-xl mx-auto px-8 py-24 type-xl-regular [&_h1]:type-3xl-semibold [&_h2]:type-3xl-semibold [&_a]:underline">
      <Content />
    </main>
  </body>
</html>
