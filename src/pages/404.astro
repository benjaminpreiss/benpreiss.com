---
import { getEntry, render } from "astro:content";
import "../../styles/globals.css";
const entry = await getEntry("system", "not-found");
if (!entry) throw new Error("Missing not-found document");
const { Content } = await render(entry);
---

<!doctype html>
<html
  lang="de"
  class="font-fgt [font-synthesis:none] text-ben-black [-webkit-tap-highlight-color:transparent]"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={entry.data.description} />
    <title>{entry.data.title}</title>
  </head>
  <body class="text-base font-[350] [&_strong]:font-semibold [&_em]:font-[450] [&_em]:italic">
    <main class="max-w-xl mx-auto px-8 py-24 font-fgt text-xl [&_h1]:font-fg [&_h1]:font-semibold [&_h1]:text-3xl [&_h2]:font-fg [&_h2]:font-semibold [&_h2]:text-3xl [&_a]:underline">
      <Content />
    </main>
  </body>
</html>
