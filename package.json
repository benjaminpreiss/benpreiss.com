{
  "name": "ben-preiss-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "fonts:generate": "node scripts/fonts.mjs",
    "fonts:check": "node scripts/fonts.mjs --check",
    "preview": "astro preview --host 127.0.0.1",
    "build": "astro build",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts tests *.ts *.js *.mjs *.cjs && node scripts/markdoc-hygiene.ts --check",
    "format": "node scripts/format.ts --write",
    "format:check": "node scripts/format.ts --check",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@astrojs/markdoc": "2.1.0",
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/svelte": "9.1.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@markdoc/markdoc": "0.5.10",
    "@videojs/html": "10.1.0",
    "astro": "7.4.0",
    "hls.js": "1.7.3",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "autoprefixer": "10.6.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "subset-font": "2.9.0",
    "svelte-check": "4.7.7",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.8.0"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
