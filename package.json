{
  "name": "benpreiss.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/fonts.mjs && astro dev --host 127.0.0.1",
    "fonts:generate": "node scripts/fonts.mjs",
    "fonts:check": "node scripts/fonts.mjs --check",
    "preview": "astro preview --host 127.0.0.1",
    "cloudflare:check": "pnpm build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cloudflare:dev": "pnpm build && wrangler dev --local --ip 127.0.0.1 --port 44325",
    "cloudflare:preview": "pnpm build && wrangler preview",
    "build": "node scripts/fonts.mjs && astro build",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts tests *.ts *.js *.mjs *.cjs && node scripts/markdoc-hygiene.ts --check",
    "format": "node scripts/format.ts --write",
    "format:check": "node scripts/format.ts --check",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@astrojs/markdoc": "2.1.3",
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/svelte": "9.1.2",
    "@fontsource-variable/work-sans": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@markdoc/markdoc": "0.5.11",
    "@videojs/html": "10.3.0",
    "astro": "7.4.7",
    "hls.js": "1.7.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "autoprefixer": "10.6.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "subset-font": "2.9.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.8.0"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
